rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /* =====================================
       USUÁRIOS
    ===================================== */

    function usuarioExiste() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        );
    }

    function usuarioAtivo() {
      return usuarioExiste()
        && firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.ativo == true;
    }

    function eAdministrador() {
      return usuarioAtivo()
        && firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.role == "admin";
    }

        function eCliente() {
      return usuarioAtivo()
        && firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.role == "cliente";
    }

    function eFuncionario() {
      return usuarioAtivo()
        && firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.role == "funcionario";
    }

    /* =====================================
       ORDENS DE SERVIÇO
    ===================================== */

    function ordemExiste(ordemId) {
      return firestore.exists(
        /databases/(default)/documents/ordens/$(ordemId)
      );
    }

    function clientePodeAcessarOrdem(ordemId) {
      return eCliente()
        && (
          firestore.get(
            /databases/(default)/documents/ordens/$(ordemId)
          ).data.clienteUid == request.auth.uid

          || (
            "clientesAutorizadosIds" in firestore.get(
              /databases/(default)/documents/ordens/$(ordemId)
            ).data

            && firestore.get(
              /databases/(default)/documents/ordens/$(ordemId)
            ).data.clientesAutorizadosIds is list

            && request.auth.uid in firestore.get(
              /databases/(default)/documents/ordens/$(ordemId)
            ).data.clientesAutorizadosIds
          )
        );
    }

    function podeAcessarOrdem(ordemId) {
      return ordemExiste(ordemId)
        && (
          eAdministrador()
          || clientePodeAcessarOrdem(ordemId)
        );
    }

    function ordemAceitaImagens(ordemId) {
      return ordemExiste(ordemId)

        && firestore.get(
          /databases/(default)/documents/ordens/$(ordemId)
        ).data.status in [
          "nova-solicitacao",
          "em-analise",
          "aguardando-confirmacao",
          "agendada"
        ]

        && !(
          "documentoFinal" in firestore.get(
            /databases/(default)/documents/ordens/$(ordemId)
          ).data
        );
    }

        function ordemEhVistoria(ordemId) {
  return ordemExiste(ordemId)
    && firestore.get(
      /databases/(default)/documents/ordens/$(ordemId)
    ).data.tipoAtendimento == "vistoria";
}

function imagemValida(ordemId, arquivo) {
  return (
    arquivo.matches('foto-[1-6][.]webp')
    || (
      ordemEhVistoria(ordemId)
      && arquivo.matches('foto-[A-Za-z0-9_-]+[.]webp')
    )
  )

    && request.resource.size > 0

    && request.resource.size <= 2 * 1024 * 1024

    && request.resource.contentType == "image/webp"

    && request.resource.metadata.ordemId == ordemId

    && request.resource.metadata.enviadoPorUid == request.auth.uid;
}

    function imagemOsRapidaValida(ordemId, arquivo) {
      return imagemValida(ordemId, arquivo)

        && "origem" in request.resource.metadata

        && request.resource.metadata.origem == "os-rapida";
    }

    /* =====================================
       IMAGENS DAS ORDENS
    ===================================== */

    match /ordens/{ordemId}/imagens/{arquivo} {

      allow read: if podeAcessarOrdem(ordemId);

            allow create: if (
        eAdministrador()
        && !ordemExiste(ordemId)
        && imagemOsRapidaValida(ordemId, arquivo)
      )
      || (
        podeAcessarOrdem(ordemId)
        && ordemAceitaImagens(ordemId)
        && imagemValida(ordemId, arquivo)
      );

      allow update: if false;

            allow delete: if (
        eAdministrador()
        && !ordemExiste(ordemId)
        && "origem" in resource.metadata
        && resource.metadata.origem == "os-rapida"
        && resource.metadata.enviadoPorUid == request.auth.uid
      )
      || (
        podeAcessarOrdem(ordemId)
        && ordemAceitaImagens(ordemId)
        && (
          eAdministrador()
          || resource.metadata.enviadoPorUid == request.auth.uid
        )
      );
    }
    /* =====================================
       IMAGENS DAS VISTORIAS
    ===================================== */

    function vistoriaExiste(vistoriaId) {
      return firestore.exists(
        /databases/(default)/documents/vistorias/$(vistoriaId)
      );
    }

    function funcionarioPodeAcessarVistoria(vistoriaId) {
      return eFuncionario()
        && vistoriaExiste(vistoriaId)
        && (
          (
            "tecnico" in firestore.get(
              /databases/(default)/documents/vistorias/$(vistoriaId)
            ).data
            && firestore.get(
              /databases/(default)/documents/vistorias/$(vistoriaId)
            ).data.tecnico.uid == request.auth.uid
          )
          ||
          (
            "execucaoFuncionario" in firestore.get(
              /databases/(default)/documents/vistorias/$(vistoriaId)
            ).data
            && firestore.get(
              /databases/(default)/documents/vistorias/$(vistoriaId)
            ).data.execucaoFuncionario.funcionarioUid == request.auth.uid
          )
        );
    }

    function clientePodeAcessarVistoria(vistoriaId) {
      return eCliente()
        && vistoriaExiste(vistoriaId)
        && "clienteUid" in firestore.get(
          /databases/(default)/documents/vistorias/$(vistoriaId)
        ).data
        && firestore.get(
          /databases/(default)/documents/vistorias/$(vistoriaId)
        ).data.clienteUid == request.auth.uid;
    }

    function podeAcessarVistoria(vistoriaId) {
      return vistoriaExiste(vistoriaId)
        && (
          eAdministrador()
          || funcionarioPodeAcessarVistoria(vistoriaId)
          || clientePodeAcessarVistoria(vistoriaId)
        );
    }

    function podeEnviarImagemVistoria(vistoriaId) {
      return vistoriaExiste(vistoriaId)
        && (
          eAdministrador()
          || funcionarioPodeAcessarVistoria(vistoriaId)
        );
    }

    function imagemVistoriaValida(vistoriaId, arquivo) {
      return arquivo.matches('foto-[A-Za-z0-9_-]+[.]webp')
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == "image/webp"
        && request.resource.metadata.vistoriaId == vistoriaId
        && request.resource.metadata.enviadoPorUid == request.auth.uid
        && request.resource.metadata.origem == "vistoria";
    }

    match /vistorias/{vistoriaId}/imagens/{arquivo} {
      allow read: if podeAcessarVistoria(vistoriaId);

      allow create: if podeEnviarImagemVistoria(vistoriaId)
        && imagemVistoriaValida(vistoriaId, arquivo);

      allow update: if false;

      allow delete: if eAdministrador()
        || (
          funcionarioPodeAcessarVistoria(vistoriaId)
          && resource.metadata.enviadoPorUid == request.auth.uid
        );
    }

    /* =====================================
       CONDOMÍNIOS
    ===================================== */

            function condominioExiste(condominioId) {
      return firestore.exists(
        /databases/(default)/documents/condominios/$(condominioId)
      );
    }

    function clientePodeAcessarCondominio(condominioId) {
      return eCliente()
        && condominioExiste(condominioId)

        && "clientesIds" in firestore.get(
          /databases/(default)/documents/condominios/$(condominioId)
        ).data

        && firestore.get(
          /databases/(default)/documents/condominios/$(condominioId)
        ).data.clientesIds is list

        && request.auth.uid in firestore.get(
          /databases/(default)/documents/condominios/$(condominioId)
        ).data.clientesIds;
    }

    function pdfValido(condominioId, arquivo) {
      return arquivo.matches('.*[.]pdf')

        && request.resource.size > 0

        && request.resource.size <= 10 * 1024 * 1024

        && request.resource.contentType == "application/pdf"

        && request.resource.metadata.condominioId == condominioId

        && request.resource.metadata.enviadoPorUid == request.auth.uid;
    }

    /* =====================================
       DOCUMENTOS DOS CONDOMÍNIOS
    ===================================== */

    match /condominios/{condominioId}/documentos/{arquivo} {

                 allow read: if (
        eAdministrador()
        && condominioExiste(condominioId)
      )
      || clientePodeAcessarCondominio(condominioId);

      allow create: if eAdministrador()
        && condominioExiste(condominioId)
        && pdfValido(condominioId, arquivo);

      allow update: if false;

      allow delete: if eAdministrador()
        && condominioExiste(condominioId);
    }

        /* =====================================
       DOCUMENTOS PRIVADOS DOS FUNCIONÁRIOS
    ===================================== */

    function funcionarioExiste(funcionarioId) {
      return firestore.exists(
        /databases/(default)/documents/funcionarios/$(funcionarioId)
      );
    }

    function documentoFuncionarioValido(funcionarioId, categoria) {
      return categoria in [
        "identificacao",
        "contrato",
        "certificados",
        "outros"
      ]
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          "application/pdf",
          "image/jpeg",
          "image/png",
          "image/webp"
        ]
        && request.resource.metadata.funcionarioId == funcionarioId
        && request.resource.metadata.categoria == categoria
        && request.resource.metadata.enviadoPorUid == request.auth.uid;
    }

        match /funcionarios-privados/{funcionarioId}/documentos/{categoria}/{arquivo} {
      allow read: if eAdministrador();

      allow create: if eAdministrador()
        && funcionarioExiste(funcionarioId)
        && documentoFuncionarioValido(funcionarioId, categoria);

      allow update: if false;

      allow delete: if eAdministrador();
    }

    /* =====================================
       IMAGEM DOS ORÇAMENTOS
    ===================================== */

    function imagemOrcamentoValida(orcamentoId, arquivo) {
      return arquivo == "capa.webp"
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == "image/webp"
        && request.resource.metadata.orcamentoId == orcamentoId
        && request.resource.metadata.enviadoPorUid == request.auth.uid
        && request.resource.metadata.enviadoPorPerfil == "admin"
        && request.resource.metadata.origem == "orcamento";
    }

    match /orcamentos/{orcamentoId}/{arquivo} {
      allow read: if eAdministrador();

      allow create: if eAdministrador()
        && imagemOrcamentoValida(orcamentoId, arquivo);

      allow update: if false;

      allow delete: if eAdministrador();
    }

    /* =====================================
       BLOQUEIO GERAL
    ===================================== */

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}